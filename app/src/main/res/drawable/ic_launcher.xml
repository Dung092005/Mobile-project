<?xml version="1.0" encoding="utf-8"?>
<!-- Legacy launcher icon (API 24-25). API 26+ uses drawable-anydpi-v26/ic_launcher.xml. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:angle="315"
                android:endColor="@color/brand_bright"
                android:startColor="@color/brand_deep" />
            <corners android:radius="12dp" />
            <size
                android:width="48dp"
                android:height="48dp" />
        </shape>
    </item>
    <item
        android:bottom="10dp"
        android:drawable="@drawable/ic_pawn"
        android:left="10dp"
        android:right="10dp"
        android:top="10dp" />
</layer-list>
