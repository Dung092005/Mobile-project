<?xml version="1.0" encoding="utf-8"?>
<!-- Landing (lookup) screen. The gradient background works without any media file. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/landing"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_landing"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="@dimen/space_s"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="@dimen/space_xl">

        <LinearLayout
            android:id="@+id/landing_content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginStart="@dimen/landing_side_margin"
            android:layout_marginEnd="@dimen/landing_side_margin"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="@dimen/space_l"
            android:paddingBottom="@dimen/space_l">

            <ImageView
                android:layout_width="@dimen/logo_hero"
                android:layout_height="@dimen/logo_hero"
                android:background="@drawable/bg_logo_badge"
                android:importantForAccessibility="no"
                android:padding="@dimen/space_l"
                android:src="@drawable/ic_pawn" />

            <TextView
                style="@style/Text.HeroTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:accessibilityHeading="true"
                android:text="@string/brand_name" />

            <TextView
                style="@style/Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/brand_tagline"
                android:textColor="@color/brand_tint" />

            <TextView
                style="@style/Text.HeroSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:gravity="center"
                android:text="@string/landing_subtitle" />

            <include
                layout="@layout/view_search_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxl" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
