<?xml version="1.0" encoding="utf-8"?>
<!-- One selectable game type. Inflated into the GridLayout by StatsPanel. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_tile"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="@dimen/tile_min_height"
    android:orientation="vertical"
    android:padding="@dimen/space_m">

    <!-- The game-type icon is set as a start compound drawable in StatsPanel. -->
    <TextView
        android:id="@+id/tile_name"
        style="@style/Text.Label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:drawablePadding="@dimen/space_s"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:textColor="@color/ink" />

    <TextView
        android:id="@+id/tile_rating"
        style="@style/Text.RatingMid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:ellipsize="end"
        android:maxLines="1" />
</LinearLayout>
