<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Platform Material theme: no AppCompat/Material Components dependency needed. -->
    <style name="Theme.ChessStats.Base" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/brand</item>
        <item name="android:colorPrimaryDark">@color/brand_deep</item>
        <item name="android:colorAccent">@color/brand_bright</item>
        <item name="android:colorControlActivated">@color/brand_bright</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:windowBackground">@color/canvas</item>
        <!-- Bars are drawn edge-to-edge; MainActivity pads content with the system insets. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <!-- API 24-25 cannot draw dark navigation icons, so keep a translucent scrim there. -->
        <item name="android:navigationBarColor">@color/scrim_dark</item>
    </style>

    <style name="Theme.ChessStats" parent="Theme.ChessStats.Base" />
</resources>
